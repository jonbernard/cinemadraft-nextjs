{
  "name": "cinemadraft",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "vercel-build": "prisma migrate deploy && next build",
    "db:deploy": "prisma migrate deploy",
    "start": "next start",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "layering": "bash scripts/layering.sh",
    "format": "biome format --write",
    "format:check": "biome format",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "e2e:journeys": "DEMO_PACE=1 playwright test e2e/journeys --workers=1",
    "e2e:film": "bash scripts/journey-film.sh",
    "db:up": "docker compose -f docker-compose.local.yml up -d --wait",
    "db:down": "docker compose -f docker-compose.local.yml down",
    "db:psql": "\"$(brew --prefix libpq)\"/bin/psql postgresql://cinemadraft:local@localhost:5433/cinemadraft",
    "lock": "docker run --rm -v \"$PWD\":/repo -w /repo node:24 npm install --package-lock-only --ignore-scripts --no-audit --no-fund",
    "typegen": "next typegen",
    "postinstall": "prisma generate",
    "test:ci": "vitest run --config vitest.ci.config.mts",
    "verify": "npm run lint && npm run typecheck && npm run layering && npm run test && npm run test:ci && npm run build",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "agent:up": "bash scripts/agent-up.sh",
    "agent:down": "bash scripts/agent-down.sh",
    "agent:baseline": "bash scripts/agent-baseline.sh"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.10.7",
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@hello-pangea/dnd": "^18.0.1",
    "@mui/material": "^9.6.0",
    "@mui/material-nextjs": "^9.6.0",
    "@prisma/adapter-neon": "^7.10.1",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@vercel/analytics": "^2.0.1",
    "@vercel/functions": "^3.9.3",
    "clsx": "^2.1.1",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "^3.7.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@clerk/testing": "^2.3.6",
    "@playwright/test": "^1.65.1",
    "@storybook/addon-a11y": "^10.6.8",
    "@storybook/addon-docs": "^10.6.8",
    "@storybook/nextjs-vite": "^10.6.8",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vercel/blob": "^2.8.0",
    "@vitejs/plugin-react": "^6.3.0",
    "dotenv": "^18.0.10",
    "jsdom": "^30.1.3",
    "pg": "^8.23.1",
    "prisma": "^7.10.1",
    "storybook": "^10.6.8",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": "24.x"
  }
}
