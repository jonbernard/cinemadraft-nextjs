generator client {
  provider            = "prisma-client"
  output              = "../generated/prisma"
  importFileExtension = ""
  moduleFormat        = "esm"
}

datasource db {
  provider = "postgresql"
}

model AvailableYear {
  id        Int       @id @default(autoincrement())
  year      Int?      @unique
  createdAt DateTime? @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime? @map("updated_at") @db.Timestamptz(6)
  /// The active season, settable from the running app rather than by rebuild
  /// (D22). At most one row may be true; enforced by the partial unique index
  /// available_years_one_active, which Prisma cannot express in the schema and
  /// which therefore lives in the migration SQL.
  isActive  Boolean   @default(false) @map("is_active")

  @@map("available_years")
}

model Award {
  id                  Int       @id @default(autoincrement())
  fbId                String?   @map("fb_id")
  name                String
  eventId             BigInt    @map("event_id")
  active              Boolean?  @default(false)
  points              Int?
  requiresNomineeName Boolean?  @default(false) @map("requires_nominee_name")
  createdAt           DateTime? @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime? @map("updated_at") @db.Timestamptz(6)

  @@index([eventId], map: "awards_event_id")
  @@map("awards")
}

model DraftPick {
  id        Int       @id @default(autoincrement())
  draftId   Int       @map("draft_id")
  movieId   BigInt    @map("movie_id")
  order     Int
  userId    Int?      @map("user_id")
  createdAt DateTime? @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime? @map("updated_at") @db.Timestamptz(6)

  @@index([draftId], map: "draft_picks_draft_id")
  @@index([movieId], map: "draft_picks_movie_id")
  @@map("draft_picks")
}

model Draft {
  id        Int       @id @default(autoincrement())
  userId    Int?      @map("user_id")
  leagueId  Int?      @map("league_id")
  year      Int?
  group     Int?
  order     Int?
  dummy     Boolean?
  dummyName String?   @map("dummy_name")
  createdAt DateTime? @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime? @map("updated_at") @db.Timestamptz(6)

  @@index([leagueId], map: "drafts_league_id")
  @@index([userId], map: "drafts_user_id")
  @@index([year], map: "drafts_year")
  @@map("drafts")
}

model Event {
  id             Int       @id @default(autoincrement())
  fbId           String?   @map("fb_id")
  name           String
  abbreviation   String
  image          String?
  liveResults    Boolean?  @default(false) @map("live_results")
  nomActive      Boolean?  @default(false) @map("nom_active")
  nomDate        BigInt?   @map("nom_date")
  nomTime        BigInt?   @map("nom_time")
  nomDuration    BigInt?   @map("nom_duration")
  awardsActive   Boolean?  @default(false) @map("awards_active")
  awardsDate     BigInt?   @map("awards_date")
  awardsTime     BigInt?   @map("awards_time")
  awardsDuration BigInt?   @map("awards_duration")
  createdAt      DateTime? @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime? @map("updated_at") @db.Timestamptz(6)

  @@index([abbreviation], map: "events_abbreviation")
  @@index([nomDate, awardsDate], map: "events_nom_date_awards_date")
  @@map("events")
}

model League {
  id             Int                   @id @default(autoincrement())
  fbId           String?               @map("fb_id")
  activeYear     Int?                  @map("active_year")
  draftingStatus LeagueDraftingStatus? @map("drafting_status")
  type           LeagueType?
  name           String
  owner          String
  uuid           String?               @db.Uuid
  createdAt      DateTime?             @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime?             @map("updated_at") @db.Timestamptz(6)

  @@map("leagues")
}

model List {
  id        Int         @id @default(autoincrement())
  userId    Int?        @map("user_id")
  movieId   Int?        @map("movie_id")
  order     Int
  year      Int
  createdAt DateTime?   @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime?   @map("updated_at") @db.Timestamptz(6)
  status    ListStatus? @default(none)

  @@index([userId], map: "lists_user_id")
  @@index([year], map: "lists_year")
  @@map("lists")
}

model Movie {
  id          Int       @id @default(autoincrement())
  title       String?
  sortTitle   String?   @map("sort_title")
  fbId        String?   @map("fb_id") @db.VarChar(255)
  imdbId      String?   @map("imdb_id") @db.VarChar(255)
  tmdbId      String?   @map("tmdb_id") @db.VarChar(255)
  backdrop    String?
  poster      String?
  releaseDate DateTime? @map("release_date") @db.Timestamptz(6)
  createdAt   DateTime? @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime? @map("updated_at") @db.Timestamptz(6)
  /// Poster-derived accent colour, cached so the extraction runs once per
  /// movie rather than on every render. Luminance-clamped at write time.
  accentHex   String?   @map("accent_hex") @db.VarChar(7)

  @@index([tmdbId], map: "movies_tmdb_id")
  @@map("movies")
}

model Nomination {
  id              Int       @id @default(autoincrement())
  fbId            String?   @map("fb_id")
  movieId         BigInt    @map("movie_id")
  awardId         BigInt    @map("award_id")
  year            Int?
  detailName      String?   @map("detail_name")
  detailCharacter String?   @map("detail_character")
  detailId        BigInt?   @map("detail_id")
  createdAt       DateTime? @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime? @map("updated_at") @db.Timestamptz(6)

  @@index([awardId], map: "nominations_award_id")
  @@index([movieId], map: "nominations_movie_id")
  @@index([year], map: "nominations_year")
  @@map("nominations")
}

model Notification {
  id        Int       @id @default(autoincrement())
  message   String?
  icon      String?
  link      String?
  userId    BigInt?   @map("user_id")
  read      Boolean?  @default(false)
  createdAt DateTime? @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime? @map("updated_at") @db.Timestamptz(6)

  @@index([userId], map: "notifications_user_id")
  @@map("notifications")
}

model Point {
  id        Int       @id @default(autoincrement())
  level     String?   @db.VarChar(255)
  tier      Int?
  points    Int?
  createdAt DateTime? @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime? @map("updated_at") @db.Timestamptz(6)

  @@map("points")
}

model ProfileFeed {
  id         Int       @id @default(autoincrement())
  message    String?
  icon       String?
  link       String?
  components String?
  userUuid   String?   @map("user_uuid")
  createdAt  DateTime? @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime? @map("updated_at") @db.Timestamptz(6)

  @@index([userUuid], map: "profile_feeds_user_uuid")
  @@map("profile_feeds")
}

model Review {
  id        Int       @id @default(autoincrement())
  userId    Int?      @map("user_id")
  movieId   Int?      @map("movie_id")
  rating    Decimal?  @db.Decimal
  review    String?
  createdAt DateTime? @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime? @map("updated_at") @db.Timestamptz(6)

  @@index([movieId], map: "reviews_movie_id")
  @@index([userId], map: "reviews_user_id")
  @@map("reviews")
}

model User {
  id         Int       @id @default(autoincrement())
  uuid       String?   @unique @db.Uuid
  firstName  String?   @map("first_name") @db.VarChar(255)
  lastName   String?   @map("last_name") @db.VarChar(255)
  email      String    @unique @db.VarChar(255)
  role       UserRole? @default(user)
  image      String?
  provider   String?
  providerId String?   @map("provider_id")
  lastLogin  DateTime? @map("last_login") @db.Timestamptz(6)
  createdAt  DateTime? @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime? @map("updated_at") @db.Timestamptz(6)
  /// Set when a Clerk identity claims this account by verified email (D25).
  /// Nullable: every existing user is unclaimed until they first sign in.
  /// Unique so a second Clerk identity cannot attach to an already-claimed
  /// account, which would be an account-takeover vector.
  clerkId    String?   @unique @map("clerk_id")

  @@index([providerId], map: "users_provider_id")
  @@map("users")
}

model Watchlist {
  id        Int       @id @default(autoincrement())
  movieId   BigInt?   @map("movie_id")
  userId    BigInt?   @map("user_id")
  createdAt DateTime? @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime? @map("updated_at") @db.Timestamptz(6)

  @@index([userId], map: "watchlists_user_id")
  @@map("watchlists")
}

model Winner {
  id           Int       @id @default(autoincrement())
  fbId         String?   @map("fb_id") @db.VarChar(255)
  movieId      BigInt    @map("movie_id")
  awardId      BigInt    @map("award_id")
  nominationId BigInt    @map("nomination_id")
  year         Int
  createdAt    DateTime? @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime? @map("updated_at") @db.Timestamptz(6)

  @@index([awardId], map: "winners_award_id")
  @@index([movieId], map: "winners_movie_id")
  @@index([nominationId], map: "winners_nomination_id")
  @@index([year], map: "winners_year")
  @@map("winners")
}

enum LeagueDraftingStatus {
  pending
  active
  complete

  @@map("enum_leagues_drafting_status")
}

enum LeagueType {
  linear
  snake

  @@map("enum_leagues_type")
}

enum ListStatus {
  none
  selected
  unavailable

  @@map("enum_lists_status")
}

enum UserRole {
  admin
  user

  @@map("enum_users_role")
}
